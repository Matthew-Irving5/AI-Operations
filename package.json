{
  "name": "ai-operations",
  "private": true,
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=10.18.0"
  },
  "scripts": {
    "dev": "corepack pnpm --filter @ai-operations/web dev",
    "build": "corepack pnpm --filter @ai-operations/web build",
    "format": "prettier --write .github apps/web packages docs infrastructure supabase/migrations supabase/tests tests package.json pnpm-workspace.yaml turbo.json tsconfig.base.json playwright.config.ts playwright.live.config.ts README.md .prettierrc.json",
    "format:check": "prettier --check .github apps/web packages docs infrastructure supabase/migrations supabase/tests tests package.json pnpm-workspace.yaml turbo.json tsconfig.base.json playwright.config.ts playwright.live.config.ts README.md .prettierrc.json",
    "lint": "corepack pnpm -r --if-present run lint",
    "typecheck": "corepack pnpm -r --if-present run typecheck",
    "test": "corepack pnpm -r --if-present run test && corepack pnpm exec tsx --test infrastructure/scripts/required-specs.test.ts infrastructure/scripts/environment-drift.test.ts infrastructure/scripts/release-gate.test.ts infrastructure/scripts/production-smoke.test.ts infrastructure/scripts/qa-doctor.test.ts infrastructure/scripts/local-qa-preflight.test.ts infrastructure/scripts/verify-changed.test.ts infrastructure/scripts/qa-debug.test.ts",
    "test:release-gate": "corepack pnpm exec tsx --test infrastructure/scripts/release-gate.test.ts",
    "test:db": "supabase test db",
    "test:e2e": "node --env-file-if-exists=.env --import tsx infrastructure/scripts/run-e2e.ts",
    "qa:local": "node --env-file-if-exists=.env --import tsx infrastructure/scripts/run-e2e.ts",
    "qa:preflight": "node --env-file-if-exists=.env --import tsx infrastructure/scripts/local-qa-preflight.ts",
    "test:e2e:live": "node --env-file-if-exists=.env --import tsx infrastructure/scripts/run-live-e2e.ts suite",
    "test:e2e:live:fixture-mismatch": "node --env-file-if-exists=.env --import tsx infrastructure/scripts/run-live-e2e.ts fixture-mismatch",
    "test:e2e:live:mismatch": "tsx infrastructure/scripts/run-live-e2e.ts mismatch",
    "test:e2e:live:fixtures": "node --env-file-if-exists=.env --import tsx infrastructure/scripts/run-live-e2e.ts fixtures",
    "security": "corepack pnpm audit --audit-level=high && gitleaks detect --no-banner",
    "verify": "corepack pnpm format:check && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm build",
    "cloudflare:check": "corepack pnpm --dir apps/web run deploy -- --dry-run",
    "verify:ci": "tsx infrastructure/scripts/verify-ci.ts",
    "environment:drift": "tsx infrastructure/scripts/environment-drift.ts",
    "preflight": "tsx infrastructure/scripts/pass-preflight.ts",
    "finish-pass": "tsx infrastructure/scripts/pass-finish.ts",
    "qa:doctor": "node --env-file-if-exists=.env --import tsx infrastructure/scripts/qa-doctor.ts",
    "qa:debug": "node --env-file-if-exists=.env --import tsx infrastructure/scripts/qa-debug.ts",
    "verify:changed": "node --env-file-if-exists=.env --import tsx infrastructure/scripts/verify-changed.ts",
    "repo:map": "node --import tsx infrastructure/scripts/repo-map.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.61.1",
    "@types/node": "22.15.3",
    "@vitest/coverage-v8": "4.1.11",
    "prettier": "3.6.2",
    "supabase": "^2.118.0",
    "tsx": "4.20.3",
    "turbo": "2.9.14",
    "typescript": "5.8.3",
    "vitest": "4.1.11",
    "zod": "4.1.5"
  },
  "pnpm": {
    "overrides": {
      "nanoid": "3.3.18",
      "playwright": "1.61.1",
      "postcss": "8.5.25",
      "sharp": "0.35.5",
      "undici": "7.29.1",
      "vitest": "4.1.11",
      "js-yaml": "4.3.2",
      "qs": "6.16.0",
      "braces": "workspace:@ai-operations/braces-safe@*",
      "proxy-addr": "2.0.8",
      "source-map-js": "1.2.2",
      "brace-expansion@<1.1.21": "1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "2.1.7",
      "brace-expansion@>=4.0.0 <5.0.12": "5.0.12"
    }
  }
}
